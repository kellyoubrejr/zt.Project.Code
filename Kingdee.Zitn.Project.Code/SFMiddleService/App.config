<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 监听端口，公网映射到该端口 -->
    <add key="port" value="8080" />
    <!-- 访问令牌，K3 的 SF_MiddleServiceToken 要与之一致，务必改成随机串 -->
    <add key="token" value="change-me-to-a-random-token" />
    <!-- 待拉取目录 / 已归档目录（相对程序目录，也可填绝对路径） -->
    <add key="inbox" value="inbox" />
    <add key="done" value="done" />
  </appSettings>
</configuration>
